{
  "port": 8090,
  "api_key": "test",
  "free_pattern": "free",
  "refresh_minutes": 30,
  "cooldown_seconds": 120,
  "first_byte_timeout_seconds": 90,
  "max_attempts": 8,
  "priority": [],
  "cascade_exclude": [
    "orca/orcaverify-text1.0-free"
  ],
  "default_context_length": 0,
  "providers": [
    {
      "name": "orcarouter",
      "baseUrl": "https://api.orcarouter.ai/v1",
      "apiKey": "env:ORCAROUTER_API_KEY"
    },
    {
      "name": "groq",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKey": "env:GROQ_API_KEY",
      "freePattern": ".*"
    },
    {
      "name": "openrouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "env:OPENROUTER_API_KEY"
    },
    {
      "name": "cohere",
      "baseUrl": "https://api.cohere.ai/compatibility/v1",
      "apiKey": "env:COHERE_API_KEY",
      "freePattern": ".*"
    },
    {
      "name": "zai",
      "baseUrl": "https://api.z.ai/api/paas/v4",
      "apiKey": "env:ZAI_API_KEY",
      "freePattern": "^$",
      "include": [
        "glm-4.7-flash",
        "glm-4.5-flash",
        "glm-4.6v-flash"
      ]
    }
  ],
  "exclude_pattern": "guard|safety|whisper|tts|orpheus|embed|rerank|moderation|verify|transcri|speech|audio|image-gen|dall-e",
  "min_context": 8192,
  "prefer_different_providers": true
}